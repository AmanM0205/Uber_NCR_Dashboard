          </named-connection>
        </named-connections>
        <relation connection='textscan.uber01' name='uber_rides_clean.csv' table='[uber_rides_clean#csv]' type='table'>
          <columns character-set='UTF-8' header='yes' locale='en_IN' separator=','><column datatype='integer' name="Ride Key" ordinal='0' /><column datatype='date' name="Date" ordinal='1' /><column datatype='string' name="Time" ordinal='2' /><column datatype='string' name="Booking ID" ordinal='3' /><column datatype='string' name="Booking Status" ordinal='4' /><column datatype='string' name="Customer ID" ordinal='5' /><column datatype='string' name="Vehicle Type" ordinal='6' /><column datatype='string' name="Pickup Location" ordinal='7' /><column datatype='string' name="Drop Location" ordinal='8' /><column datatype='real' name="Avg VTAT" ordinal='9' /><column datatype='real' name="Avg CTAT" ordinal='10' /><column datatype='string' name="Reason for cancelling by Customer" ordinal='11' /><column datatype='string' name="Driver Cancellation Reason" ordinal='12' /><column datatype='string' name="Incomplete Rides Reason" ordinal='13' /><column datatype='real' name="Booking Value" ordinal='14' /><column datatype='real' name="Ride Distance" ordinal='15' /><column datatype='real' name="Driver Ratings" ordinal='16' /><column datatype='real' name="Customer Rating" ordinal='17' /><column datatype='string' name="Payment Method" ordinal='18' /><column datatype='datetime' name="Booking Datetime" ordinal='19' /><column datatype='integer' name="Month Num" ordinal='20' /><column datatype='string' name="Month" ordinal='21' /><column datatype='integer' name="Weekday Num" ordinal='22' /><column datatype='string' name="Weekday" ordinal='23' /><column datatype='integer' name="Hour" ordinal='24' /><column datatype='string' name="Time Slot" ordinal='25' /><column datatype='string' name="Is Weekend" ordinal='26' /><column datatype='integer' name="Ride Count" ordinal='27' /><column datatype='integer' name="Is Completed" ordinal='28' /><column datatype='integer' name="Is Cancelled Customer" ordinal='29' /><column datatype='integer' name="Is Cancelled Driver" ordinal='30' /><column datatype='integer' name="Is No Driver" ordinal='31' /><column datatype='integer' name="Is Incomplete" ordinal='32' /><column datatype='real' name="Revenue" ordinal='33' /><column datatype='string' name="Failure Reason" ordinal='34' /><column datatype='string' name="Distance Band" ordinal='35' /></columns>
        </relation>
      </connection>
      <aliases enabled='yes' />
      <column datatype='integer' name='[Ride Key]' role='dimension' type='ordinal' /><column datatype='date' name='[Date]' role='dimension' type='nominal' /><column datatype='string' name='[Time]' role='dimension' type='nominal' /><column datatype='string' name='[Booking ID]' role='dimension' type='nominal' /><column datatype='string' name='[Booking Status]' role='dimension' type='nominal' /><column datatype='string' name='[Customer ID]' role='dimension' type='nominal' /><column datatype='string' name='[Vehicle Type]' role='dimension' type='nominal' /><column datatype='string' name='[Pickup Location]' role='dimension' type='nominal' /><column datatype='string' name='[Drop Location]' role='dimension' type='nominal' /><column datatype='real' default-format="n#,##0.0" name='[Avg VTAT]' role='measure' type='quantitative' /><column datatype='real' name='[Avg CTAT]' role='measure' type='quantitative' /><column datatype='string' name='[Reason for cancelling by Customer]' role='dimension' type='nominal' /><column datatype='string' name='[Driver Cancellation Reason]' role='dimension' type='nominal' /><column datatype='string' name='[Incomplete Rides Reason]' role='dimension' type='nominal' /><column datatype='real' name='[Booking Value]' role='measure' type='quantitative' /><column datatype='real' default-format="n#,##0.0" name='[Ride Distance]' role='measure' type='quantitative' /><column datatype='real' default-format="n0.00" name='[Driver Ratings]' role='measure' type='quantitative' /><column datatype='real' default-format="n0.00" name='[Customer Rating]' role='measure' type='quantitative' /><column datatype='string' name='[Payment Method]' role='dimension' type='nominal' /><column datatype='datetime' name='[Booking Datetime]' role='dimension' type='nominal' /><column datatype='integer' name='[Month Num]' role='dimension' type='ordinal' /><column datatype='string' name='[Month]' role='dimension' type='nominal' /><column datatype='integer' name='[Weekday Num]' role='dimension' type='ordinal' /><column datatype='string' name='[Weekday]' role='dimension' type='nominal' /><column datatype='integer' name='[Hour]' role='dimension' type='ordinal' /><column datatype='string' name='[Time Slot]' role='dimension' type='nominal' /><column datatype='string' name='[Is Weekend]' role='dimension' type='nominal' /><column datatype='integer' default-format="n#,##0" name='[Ride Count]' role='measure' type='quantitative' /><column datatype='integer' default-format="n#,##0" name='[Is Completed]' role='measure' type='quantitative' /><column datatype='integer' name='[Is Cancelled Customer]' role='measure' type='quantitative' /><column datatype='integer' name='[Is Cancelled Driver]' role='measure' type='quantitative' /><column datatype='integer' name='[Is No Driver]' role='measure' type='quantitative' /><column datatype='integer' name='[Is Incomplete]' role='measure' type='quantitative' /><column datatype='real' default-format='*"₹"#,##0' name='[Revenue]' role='measure' type='quantitative' /><column datatype='string' name='[Failure Reason]' role='dimension' type='nominal' /><column datatype='string' name='[Distance Band]' role='dimension' type='nominal' />
      <column caption="Dashboard Filter" datatype='boolean' name='[Calculation_filter]' role='dimension' type='nominal'><calculation class='tableau' formula='([Parameters].[Parameter 2] = "All" OR [Month] = [Parameters].[Parameter 2]) AND ([Parameters].[Parameter 3] = "All" OR [Vehicle Type] = [Parameters].[Parameter 3]) AND ([Parameters].[Parameter 4] = "All" OR [Time Slot] = [Parameters].[Parameter 4]) AND ([Parameters].[Parameter 5] = "All" OR [Pickup Location] = [Parameters].[Parameter 5])' /></column><column caption="Selected Metric" datatype='real' default-format="n#,##0" name='[Calculation_metric]' role='measure' type='quantitative'><calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;  WHEN "Bookings" THEN SUM([Ride Count])&#10;  WHEN "Completed Rides" THEN SUM([Is Completed])&#10;  WHEN "Revenue (INR)" THEN SUM([Revenue])&#10;  WHEN "Avg Fare (INR)" THEN SUM([Revenue]) / SUM([Is Completed])&#10;  WHEN "Completion Rate %" THEN 100 * SUM([Is Completed]) / SUM([Ride Count])&#10;END' /></column><column caption="Completion Rate" datatype='real' default-format="p0.0%" name='[Calculation_compl]' role='measure' type='quantitative'><calculation class='tableau' formula="SUM([Is Completed]) / SUM([Ride Count])" /></column><column caption="Revenue (INR M)" datatype='real' default-format='*"₹"#,##0.00" M"' name='[Calculation_revm]' role='measure' type='quantitative'><calculation class='tableau' formula="SUM([Revenue]) / 1000000" /></column><column caption="Avg Fare (INR)" datatype='real' default-format='*"₹"#,##0' name='[Calculation_fare]' role='measure' type='quantitative'><calculation class='tableau' formula="SUM([Revenue]) / SUM([Is Completed])" /></column><column caption="Cancellation Rate" datatype='real' default-format="p0.0%" name='[Calculation_cancel]' role='measure' type='quantitative'><calculation class='tableau' formula="(SUM([Is Cancelled Customer]) + SUM([Is Cancelled Driver])) / SUM([Ride Count])" /></column><column caption="Driver Cancel Rate" datatype='real' default-format="p0.0%" name='[Calculation_dcancel]' role='measure' type='quantitative'><calculation class='tableau' formula="SUM([Is Cancelled Driver]) / SUM([Ride Count])" /></column><column caption="Customer Cancel Rate" datatype='real' default-format="p0.0%" name='[Calculation_ccancel]' role='measure' type='quantitative'><calculation class='tableau' formula="SUM([Is Cancelled Customer]) / SUM([Ride Count])" /></column><column caption="No Driver Found Rate" datatype='real' default-format="p0.0%" name='[Calculation_nodriver]' role='measure' type='quantitative'><calculation class='tableau' formula="SUM([Is No Driver]) / SUM([Ride Count])" /></column><column caption="Has Failure Reason" datatype='boolean' name='[Calculation_hasfail]' role='dimension' type='nominal'><calculation class='tableau' formula="NOT ISNULL([Failure Reason])" /></column><column caption="Is Paid" datatype='boolean' name='[Calculation_paid]' role='dimension' type='nominal'><calculation class='tableau' formula='[Payment Method] &lt;&gt; "Not Paid"' /></column>
      <column-instance column='[Booking Status]' derivation='None' name='[none:Booking Status:nk]' pivot='key' type='nominal' />
      <extract count='-1' enabled='true' units='records'><connection access_mode='readonly' author-locale='en_US' class='hyper' dbname="C:/Users/amanm/OneDrive/Desktop/uber-ncr-dashboard/data/extract/uber_rides.hyper" default-settings='yes' schema='Extract' sslmode='' tablename='Extract' update-time="11/20/2026 11:50:39 PM" username='tableau_internal_user'><relation name='Extract' table='[Extract].[Extract]' type='table' /></connection></extract>
      <layout dim-ordering='alphabetic' dim-percentage='0.5' measure-ordering='alphabetic' measure-percentage='0.4' show-structure='true' />
      <style>
        <style-rule element='mark'>
          <encoding attr='color' field='[none:Booking Status:nk]' type='palette'><map to='#06C167'><bucket>"Completed"</bucket></map><map to='#E11900'><bucket>"Cancelled by Driver"</bucket></map><map to='#FF6937'><bucket>"Cancelled by Customer"</bucket></map><map to='#8F8F8F'><bucket>"No Driver Found"</bucket></map><map to='#FFC043'><bucket>"Incomplete"</bucket></map></encoding>
        </style-rule>
      </style>
    </datasource>
  </datasources>
  <actions><action caption="Filter from Booking Status Mix" name='[Action_be97ceaf]'><activation auto-clear='true' type='on-select' /><source dashboard="Uber NCR 2024 - Ride Overview" type='sheet' worksheet="Booking Status Mix" /><command command='tsc:tsl-filter'><param name='special-fields' value='all' /><param name='target' value="Uber NCR 2024 - Ride Overview" /></command></action><action caption="Filter from Selected Metric by Vehicle Type" name='[Action_d452c51e]'><activation auto-clear='true' type='on-select' /><source dashboard="Uber NCR 2024 - Ride Overview" type='sheet' worksheet="Selected Metric by Vehicle Type" /><command command='tsc:tsl-filter'><param name='special-fields' value='all' /><param name='target' value="Uber NCR 2024 - Ride Overview" /></command></action><action caption="Filter from Monthly Trend (Selected Metric)" name='[Action_ea8e0d1a]'><activation auto-clear='true' type='on-select' /><source dashboard="Uber NCR 2024 - Ride Overview" type='sheet' worksheet="Monthly Trend (Selected Metric)" /><command command='tsc:tsl-filter'><param name='special-fields' value='all' /><param name='target' value="Uber NCR 2024 - Ride Overview" /></command></action><action caption="Filter from Avg Driver Rating by Vehicle" name='[Action_630e839c]'><activation auto-clear='true' type='on-select' /><source dashboard="Uber NCR 2024 - Cancellations &amp; Operations" type='sheet' worksheet="Avg Driver Rating by Vehicle" /><command command='tsc:tsl-filter'><param name='special-fields' value='all' /><param name='target' value="Uber NCR 2024 - Cancellations &amp; Operations" /></command></action><action caption="Filter from Revenue by Payment Method" name='[Action_a90527b4]'><activation auto-clear='true' type='on-select' /><source dashboard="Uber NCR 2024 - Cancellations &amp; Operations" type='sheet' worksheet="Revenue by Payment Method" /><command command='tsc:tsl-filter'><param name='special-fields' value='all' /><param name='target' value="Uber NCR 2024 - Cancellations &amp; Operations" /></command></action></actions>
